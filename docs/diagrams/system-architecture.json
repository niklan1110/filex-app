  "cards": [
    {
      "dot": "emerald",
      "title": "Always on, plus default profiles",
      "items": [
        "API (serves the UI, janitor), Redis, worker-core",
        "COMPOSE_PROFILES=office,ocr,ebook by default",
        "One heavy-step slot: office, ocr and ebook never peak together"
      ]
    },
    {
      "dot": "amber",
      "title": "Auth (ADR-0009, ADR-0011)",
      "items": [
        "Local mode by default (ADR-0011); optional sign-in server verifies each Bearer token, cached up to 60 s",
        "Allowlist: user id or app_metadata.filex; fails closed",
        "Hashed fxt_ tokens for scripts; refuses to start with no auth"
      ]
    },
    {
      "dot": "cyan",
      "title": "Step hand-off",
      "items": [
        "A worker reads its own q:<group> stream",
        "On success it adds the next step to the next group's stream",
        "Downloads: 5-minute signed links, attachments only"
      ]
    },
    {
      "dot": "rose",
      "title": "Sandbox (ADR-0007)",
      "items": [
        "Workers: no network, read-only FS, cap_drop ALL, non-root",
        "Each step: child with rlimits + seccomp (no sockets); escaped processes killed",
        "Redis ACLs; results kept 24 h, inputs deleted at job end"
      ]
    }
  ]
