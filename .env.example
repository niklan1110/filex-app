# FileX configuration. Copy to .env and edit: cp .env.example .env
# .env is git-ignored. Never commit real secrets. Every value below is a placeholder.

# --- Worker groups -----------------------------------------------------------
# Optional heavy worker groups to start, comma-separated: office, ocr, ebook, ml, or all.
# core (PDF, images, signing) always runs. Groups not built yet are ignored.
COMPOSE_PROFILES=office,ocr,ebook

# Extra OCR languages for the ocr group, comma-separated Tesseract codes. The image always has
# eng, rus, deu, fra, spa, ita. Languages are baked into the image, so after changing this run:
#   docker compose build worker-ocr && docker compose up -d
# Check: docker compose exec worker-ocr tesseract --list-langs
# FILEX_OCR_EXTRA_LANGS=ukr,bel
FILEX_OCR_EXTRA_LANGS=

# --- Network -----------------------------------------------------------------
# Host address the web UI and API are published on. 127.0.0.1 = this computer only.
# To use FileX from your phone or another PC on your home network, set this to this computer's
# LAN address (e.g. 192.168.1.20), add that address to FILEX_ALLOWED_HOSTS, set
# FILEX_API_TOKENS and empty FILEX_AUTH (see docs/install.md). Never use 0.0.0.0.
FILEX_BIND=127.0.0.1
# Host port on FILEX_BIND. Change it only if 8080 is taken.
FILEX_PORT=8080
# Subnet of the workers' internal network. Change only if it collides with your LAN or another
# Docker network.
# FILEX_INTERNAL_SUBNET=10.213.83.0/24
# Addresses the browser may use for FileX (Host header), comma-separated, no http:// and no
# port, e.g. localhost,127.0.0.1,192.168.1.20
FILEX_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Redis (required) --------------------------------------------------------
# Redis passwords are NOT set here. They are Docker secret files in ./secrets (git-ignored),
# one per Redis user (api, worker). Create them once before the first start:
#   python3 scripts/make_secrets.py        (or: sh scripts/make_secrets.sh)
# Rotate: python3 scripts/make_secrets.py --force
#         docker compose up -d --force-recreate

# --- Sign-in -----------------------------------------------------------------
# Local mode: no sign-in, for this computer only. FileX refuses to start with
# FILEX_AUTH=none unless FILEX_BIND is a loopback address (127.0.0.1, ::1 or localhost).
# To turn local mode off, leave it empty: FILEX_AUTH=
FILEX_AUTH=none
# Access tokens for other devices (pasted once into the web page) and for scripts
# (Authorization: Bearer fxt_...): name:<sha256 of the token>, comma-separated. The token itself
# is never stored here. Make a token and its hash:
#   python3 -c "import secrets,hashlib; t='fxt_'+secrets.token_urlsafe(32); print(t); print(hashlib.sha256(t.encode()).hexdigest())"
# Give the first line to the device or script and put the second here, one name per device:
#   FILEX_API_TOKENS=phone:<hash1>,laptop:<hash2>
# Names: a-z 0-9 _ -, up to 32 characters, unique. Revoke a device: remove its entry and run
# docker compose up -d.
FILEX_API_TOKENS=
# Proxies whose X-Forwarded-For is trusted for the per-address limit of 20 failed sign-ins per
# minute (IPs or CIDRs). Leave as is unless you run a reverse proxy on this computer that sets
# X-Forwarded-For; trusting anything else lets a client dodge the limit.
FILEX_TRUSTED_PROXIES=127.0.0.1
# Send Strict-Transport-Security. Set to true only once FileX is reached over HTTPS alone (behind
# a reverse proxy); browsers then refuse plain http for a year.
FILEX_HSTS=false
# Key for signed download links. Leave empty: a random key is made at each start.
FILEX_DL_KEY_FILE=

# --- Limits and retention ----------------------------------------------------
# Max total upload size per job in MB (streamed to disk, not RAM).
FILEX_MAX_UPLOAD_MB=1024
# Max number of files per job.
FILEX_MAX_FILES=50
# Minutes results are kept after a job finishes (1440 = 24 h). Values above 1440 are lowered
# to 1440 with a warning in the log. Jobs that never finish are removed after 24 h. A janitor
# in the API deletes expired and orphaned files at startup and every minute.
FILEX_RETENTION_MIN=1440
# Refuse new uploads (507 INSUFFICIENT_STORAGE) when the upload would leave less free space on
# the data volume than this, in MB. 0 turns the check off. Keep it at least 2x
# FILEX_MAX_UPLOAD_MB. A running step is stopped (OUTPUT_TOO_LARGE) when free space drops below
# half of this.
FILEX_MIN_FREE_MB=4096
# Refuse new jobs (429 QUEUE_FULL, Retry-After: 30) while a worker group already has this many
# steps waiting or running. 0 turns the check off.
FILEX_MAX_QUEUED=20
# Documents with more pages than this are refused by the tools.
FILEX_MAX_PAGES=2000
# Steps each worker runs at once. 1 is right for small machines. worker-office ignores this and
# always runs 1.
FILEX_CONCURRENCY=1
# Steps that need a heavy engine (LibreOffice, OCR, Calibre) run one at a time across all groups
# with 1. 0 turns the slot off (big machines); core steps never wait for it.
FILEX_HEAVY_SLOTS=1
# Largest image (in pixels) the tools open: 100000000 = 100 megapixels.
FILEX_MAX_PIXELS=100000000
# Per-step file isolation (Landlock): auto = use it when the kernel supports it; required = a worker
# without it offers no tools; off = debugging only. Check GET /api/v1/status after the first start.
FILEX_LANDLOCK=auto

# --- Memory ------------------------------------------------------------------
# Memory limit of each worker container (RAM and swap together: no swap beyond it). Docker
# kills a step that goes over; FileX reports it as failed. Values like 768m, 1g, 1536m, 2g.
FILEX_MEM_CORE=1g
FILEX_MEM_OFFICE=1536m
FILEX_MEM_OCR=1536m
FILEX_MEM_EBOOK=1g

# --- low-memory preset (4 GB machine, or 2 GB with core only) ----------------
# Uncomment the FILEX_ lines below; nothing else needs editing (later lines win). Worst case
# ~2.4 GB with all groups, ~1.1 GB core only.
# FILEX_MEM_CORE=768m
# FILEX_MEM_OFFICE=1g
# FILEX_MEM_OCR=1g
# FILEX_MEM_EBOOK=1g
# FILEX_HEAVY_SLOTS=1
# FILEX_CONCURRENCY=1
# FILEX_MAX_PIXELS=50000000
# FILEX_MAX_PAGES=1000
# 2 GB machine only (core only, no office/ocr/ebook):
# COMPOSE_PROFILES=
